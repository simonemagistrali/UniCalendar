{
  "name": "unicalendar-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Server MCP (sola lettura) per UniCalendar: espone task, eventi, recupero lezioni e riepiloghi a qualsiasi LLM compatibile.",
  "scripts": {
    "start": "tsx src/server.ts",
    "demo": "cross-env UNICALENDAR_DEMO=1 tsx src/server.ts",
    "test": "tsx test/smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "crypto-js": "^4.2.0",
    "firebase-admin": "^13.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.0.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.0",
    "typescript": "~5.8.0"
  }
}
